# Copied to .env.production by deploy.sh — fill in real values there, never commit them.

# Choose a strong password
MYSQL_ROOT_PASSWORD=

# Generate a strong secret (run: openssl rand -hex 64)
JWT_SECRET=

# Public URL of the frontend (allowed CORS origin)
CLIENT_URL=https://your-domain.com

# Shared secret the payment provider sends in the X-Webhook-Secret header (run: openssl rand -hex 32)
WALLET_WEBHOOK_SECRET=

# SMS — AfricasTalking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
