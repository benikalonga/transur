# =============================================================================
# TRANSUR — Production Environment Variables
# Copy to .env.production and fill in your real values.
# NEVER commit .env.production to git.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ChangeMe_StrongPassword123!

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_string_from_openssl_rand_hex_32

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=transur.cd
SSL_EMAIL=beni@minitmoney.com

# ── URLs (set to your domain in production) ───────────────────────────────────
CLIENT_URL=https://transur.cd
API_URL=https://transur.cd
SOCKET_URL=https://transur.cd

# ── SMS — Africa's Talking (get live keys from africastalking.com) ────────────
AFRICASTALKING_API_KEY=your_live_api_key_here
AFRICASTALKING_USERNAME=transur
