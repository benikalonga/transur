# Used by docker-compose.yml. Copy to .env and fill in every secret.

# ── Database ──────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=YOUR_DB_ROOT_PASSWORD
DB_NAME=transur
DB_USER=transur
DB_PASSWORD=YOUR_DB_PASSWORD

# ── API ───────────────────────────────────────────────────────────────────────
# 64+ random characters: openssl rand -hex 64
JWT_SECRET=YOUR_JWT_SECRET
# Public origin of the web app (CORS + trip-sharing links)
APP_URL=https://YOUR_DOMAIN
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_USERNAME=sandbox
SMS_SENDER_ID=TRANSUR
# openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_WEBHOOK_SECRET
DEFAULT_CITY=lubumbashi
WALLET_DEBT_LIMIT=-5.00

# ── Web app (baked in at build time) ──────────────────────────────────────────
PUBLIC_API_URL=https://YOUR_DOMAIN/api
PUBLIC_SOCKET_URL=https://YOUR_DOMAIN
CURRENCY=CDF
CURRENCY_RATE=2800
MAP_CENTER=-11.6609,27.4794
PRICE_STEP=500
SEARCH_COUNTRY=cd

# ── Deployment (deploy.sh) ────────────────────────────────────────────────────
DOMAIN=YOUR_DOMAIN
LETSENCRYPT_EMAIL=YOUR_EMAIL@example.com
