# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origin of the web app (used for CORS and share links)
APP_URL=http://localhost:3000

# ── Database: MySQL 8 or MariaDB 10.6+ ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=transur
DB_USER=transur
DB_PASSWORD=YOUR_DB_PASSWORD
# Optional: connect through a Unix socket instead of host/port
# DB_SOCKET=/run/mysqld/mysqld.sock

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required, 32+ characters. Generate with: openssl rand -hex 64
JWT_SECRET=YOUR_JWT_SECRET
JWT_TTL=7d
STAFF_JWT_TTL=12h
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Development only: every login code is this value (handy for tests). Ignored in production.
# DEV_LOGIN_CODE=123456

# ── SMS (Africa's Talking) ────────────────────────────────────────────────────
# In development, codes are printed to the console instead of being sent.
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_USERNAME=sandbox
SMS_SENDER_ID=TRANSUR

# ── Marketplace ───────────────────────────────────────────────────────────────
DEFAULT_CITY=lubumbashi
# Radius in km used to find available drivers/couriers
DISPATCH_RADIUS_KM=15
# Minutes a request stays open for bids before it is cancelled
REQUEST_TTL_MINUTES=3
# Scheduled bookings are released to the fleet this many minutes early
SCHEDULE_LEAD_MINUTES=10
# Fleet wallets lock when the balance falls to this value (negative = debt allowed)
WALLET_DEBT_LIMIT=-5.00

# ── Referrals ─────────────────────────────────────────────────────────────────
REFERRAL_WELCOME_DISCOUNT=1.00
REFERRAL_REWARD_DISCOUNT=1.50

# ── Mobile money webhooks ─────────────────────────────────────────────────────
# Shared secret the payment provider sends in the X-Webhook-Secret header
# Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_WEBHOOK_SECRET
