# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=transur
DATABASE_USERNAME=root
DATABASE_PASSWORD=change_me

# JWT
# Required, 32+ characters. Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMS — AfricasTalking (https://africastalking.com)
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=TRANSUR

# Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Mobile Money
MPESA_API_URL=https://api.safaricom.com
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Shared secret the payment provider sends in the X-Webhook-Secret header
# Generate with: openssl rand -hex 32
WALLET_WEBHOOK_SECRET=

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Commission & Wallet
DEFAULT_COMMISSION_RATE=15
MAX_WALLET_DEBT=-5.00

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
