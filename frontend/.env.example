# API base URL (include /api) and Socket.IO origin
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Display currency. Fares are stored in the API base currency (USD by default);
# the app multiplies them by NEXT_PUBLIC_CURRENCY_RATE for display.
NEXT_PUBLIC_CURRENCY=CDF
NEXT_PUBLIC_CURRENCY_RATE=2800
# Smallest step riders and drivers can change an offer by, in display currency
NEXT_PUBLIC_PRICE_STEP=500

# Where maps open before GPS is available: "lat,lng"
NEXT_PUBLIC_MAP_CENTER=-11.6609,27.4794
# Optional: restrict address search to a country (ISO code, e.g. "cd", "ke")
NEXT_PUBLIC_SEARCH_COUNTRY=cd

# 1 = offline mode for machines without internet: no map tiles (plain grid), no online
# routing or address search (built-in place list, straight-line routes), and a demo
# location near NEXT_PUBLIC_MAP_CENTER when the device has no GPS.
NEXT_PUBLIC_OFFLINE_MODE=0
